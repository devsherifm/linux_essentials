def load_config():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_FILE.exists():
        CONFIG_FILE.write_text(json.dumps(DEFAULT_CONFIG, indent=2), encoding="utf-8")
        return dict(DEFAULT_CONFIG)
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        cfg = dict(DEFAULT_CONFIG)
        cfg.update(data)
        return cfg
    except Exception:
        return dict(DEFAULT_CONFIG)


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2), encoding="utf-8")


def command_exists(name):
    return any((Path(p) / name).is_file() and os.access(Path(p) / name, os.X_OK)
               for p in os.environ.get("PATH", "").split(os.pathsep) if p)


def discover_tracks(music_dir):
    root = Path(os.path.expanduser(str(music_dir)))
    if not root.exists():
        return []
    found = []
    try:
        for f in root.rglob("*"):
            if f.is_file() and f.suffix.lower() in AUDIO_EXTS:
                found.append(f)
    except OSError:
        pass
    return sorted(found, key=lambda p: str(p).lower())


def is_url(s):
    return bool(re.match(r"^https?://", str(s).strip(), re.I))


def is_youtube_url(s):
    s = str(s).lower()
    return any(x in s for x in ("youtube.com/", "youtu.be/", "youtube-nocookie.com/"))


def is_youtube_playlist_url(s):
    if not is_youtube_url(s):
        return False
    try:
        return bool(parse_qs(urlparse(str(s).strip()).query).get("list"))
    except Exception:
        return False


class MPV:
    def __init__(self):
        self.proc = None
        self.sock = None
        self.request_id = 0

    def start(self):
        try:
            SOCKET_FILE.unlink(missing_ok=True)
        except OSError:
            pass
        try:
            self.proc = subprocess.Popen(
                ["mpv", "--no-video", "--idle=yes", "--really-quiet", "--terminal=no",
                 f"--input-ipc-server={SOCKET_FILE}"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except FileNotFoundError:
            return False
        deadline = time.time() + 5
        while time.time() < deadline:
            if SOCKET_FILE.exists():
                try:
                    self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    self.sock.settimeout(0.08)
                    self.sock.connect(str(SOCKET_FILE))
                    return True
                except OSError:
                    try: self.sock.close()
                    except Exception: pass
                    self.sock = None
            time.sleep(0.05)
        return False

    def command(self, *args, timeout=0.18):
        if not self.sock:
            return None
        self.request_id += 1
        rid = self.request_id
        try:
            self.sock.sendall((json.dumps({"command": list(args), "request_id": rid}) + "\n").encode())
            end = time.time() + timeout
            data = b""
            while time.time() < end:
                try:
                    chunk = self.sock.recv(16384)
                    if chunk:
                        data += chunk
                        # mpv may send asynchronous event lines before the response.
                        # Keep reading until the response carrying our request_id arrives.
                        for line in data.splitlines():
                            try:
                                obj = json.loads(line)
                                if obj.get("request_id") == rid:
                                    return obj
                            except Exception:
                                continue
                    else:
                        break
                except socket.timeout:
                    break
            for line in data.splitlines():
                try:
                    obj = json.loads(line)
                    if obj.get("request_id") == rid:
                        return obj
                except Exception:
                    continue
        except OSError:
            pass
        return None

    def get(self, prop, default=None):
        r = self.command("get_property", prop)
        return r.get("data", default) if r and r.get("error") == "success" else default

    def set(self, prop, value):
        return self.command("set_property", prop, value)

    def load(self, target):
        return self.command("loadfile", target, "replace", timeout=1.0)

    def pause(self): return self.command("cycle", "pause")
    def seek_relative(self, sec): return self.command("seek", sec, "relative")
    def seek_absolute(self, sec): return self.command("seek", sec, "absolute")

    def quit(self):
        try: self.command("quit", timeout=0.2)
        except Exception: pass
        try:
            if self.sock: self.sock.close()
        except Exception: pass
        try:
            if self.proc and self.proc.poll() is None:
                self.proc.terminate()
                self.proc.wait(timeout=0.7)
        except Exception:
            try: self.proc.kill()
            except Exception: pass
        try: SOCKET_FILE.unlink(missing_ok=True)
        except OSError: pass


class Track:
    def __init__(self, name, target, source="Local", duration=None, is_url=False, artist="-"):
        self.name = name
        self.target = str(target)
        self.source = source
        self.duration = duration
        self.is_url = is_url
        self.artist = artist


